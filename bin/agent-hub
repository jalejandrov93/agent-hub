#!/usr/bin/env node
// Dispatch: agent-hub <mcp|hook|dashboard|preflight|selftest> [...args]
import path from 'node:path'
import { fileURLToPath } from 'node:url'

const HERE = path.dirname(fileURLToPath(import.meta.url))
const SRC = path.join(HERE, '..', 'src')

const [sub, ...rest] = process.argv.slice(2)

async function run() {
  switch (sub) {
    case 'mcp':
    case undefined: {
      process.argv = [process.argv[0], process.argv[1], ...rest]
      await import(path.join(SRC, 'index.mjs'))
      break
    }
    case 'hook': {
      const { runHook } = await import(path.join(SRC, 'hook.mjs'))
      await runHook(process.stdin)
      break
    }
    case 'dashboard': {
      const { startDashboard } = await import(path.join(SRC, 'dashboard.mjs'))
      const portFlagIndex = rest.indexOf('--port')
      const port = portFlagIndex !== -1 ? Number(rest[portFlagIndex + 1]) : 7777
      startDashboard({ port })
      break
    }
    case 'preflight': {
      const { runPreflightCli } = await import(path.join(SRC, 'preflight-cli.mjs'))
      await runPreflightCli(rest)
      break
    }
    case 'selftest': {
      process.argv = [process.argv[0], process.argv[1], '--selftest']
      await import(path.join(SRC, 'index.mjs'))
      break
    }
    default: {
      console.error(`agent-hub: unknown subcommand "${sub}". Use one of: mcp, hook, dashboard, preflight, selftest.`)
      process.exitCode = 1
    }
  }
}

run().catch((error) => {
  console.error('agent-hub: fatal:', error?.message ?? error)
  process.exitCode = 1
})
